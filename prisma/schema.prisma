// Prisma schema for Clyntique.
// The connection URL is configured in prisma.config.ts (Prisma 7), not here.
//
// Migrations live in prisma/migrations (0_init = the schema as it existed
// before migrations were introduced; later folders are additive). Never use
// `prisma db push` or `prisma migrate dev` against the shared database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEAM
  CLIENT
}

// Where a creative is in its workflow. In the submission-review workflow:
// DRAFT -> SUBMITTED -> IN_REVIEW -> CHANGES_REQUESTED -> SUBMITTED ... -> REVIEW_COMPLETE.
// APPROVED is legacy-only (a client approval in the pre-compliance workflow)
// and is never set for SUBMISSION_REVIEW creatives. REVIEW_COMPLETE only says
// the internal review cycle is closed; the human outcome is ReviewDecision.outcome.
enum CreativeStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ARCHIVED
  SUBMITTED
  REVIEW_COMPLETE
}

// Which workflow a creative belongs to. Rows that existed before the
// submission-review workflow were set to LEGACY_CLIENT_APPROVAL by migration;
// the column default makes every new row SUBMISSION_REVIEW. Never inferred
// from other columns, never updated.
enum CreativeWorkflow {
  LEGACY_CLIENT_APPROVAL
  SUBMISSION_REVIEW
}

// Placement the creative is designed for. Drives the preview aspect ratio.
enum CreativeFormat {
  STORY
  FEED
  STATIC
  VIDEO
}

// Kind of file a creative version holds. Decides image vs video preview.
enum MediaType {
  IMAGE
  VIDEO
}

enum EvidenceType {
  RESEARCH
  STATISTIC
  COMPETITOR
  CUSTOMER_INSIGHT
  SOURCE
  OTHER
  // P0 (Oct 27): client substantiation and Clyntique policy references.
  CLINICAL_STUDY
  CERTIFICATION
  POLICY_REFERENCE
}

// Who supplied a piece of evidence. Null on rows from the legacy workflow
// (their creative's workflow says they are legacy).
enum EvidenceOrigin {
  CLIENT_SUBMITTED
  REVIEWER_ADDED
}

enum EvidenceVisibility {
  SHARED // visible to the submission's client
  INTERNAL // team only
}

// Legacy: a CLIENT decision in the pre-compliance workflow. Kept unchanged as history.
enum ApprovalStatus {
  APPROVED
  CHANGES_REQUESTED
}

enum ReviewDecisionKind {
  CHANGES_REQUESTED // interim: findings published, client asked to remediate
  FINAL // closes the review cycle with an outcome
}

// Human reviewer's conclusion for a FINAL decision. Internal review only:
// not legal advice, not government approval, not platform acceptance.
// Values pending product confirmation (plan D3).
enum ReviewOutcome {
  NO_ISSUES_IDENTIFIED
  ISSUES_RESOLVED
  COMPLETED_WITH_OPEN_ISSUES
  NOT_REVIEWABLE
}

enum FindingStatus {
  DRAFT // reviewer-only, not visible to the client
  OPEN // published; client action required
  RESPONDED // client responded; awaiting reviewer
  RESOLVED // reviewer judged it resolved
  DISMISSED // reviewer withdrew it (reason recorded in FindingEvent)
}

// Reviewer-assessed severity, not a legal classification.
enum FindingSeverity {
  HIGH
  MEDIUM
  LOW
  ADVISORY
}

// What the client must do to address a finding (details in actionDetails).
enum FindingAction {
  REVISE_CONTENT
  PROVIDE_EVIDENCE
  CLARIFY
  ACKNOWLEDGE
}

enum MarketKind {
  COUNTRY
  SUBDIVISION
}

enum ActivityType {
  CREATIVE_UPLOADED
  VERSION_UPLOADED
  FEEDBACK_RECEIVED
  CHANGES_REQUESTED
  CREATIVE_APPROVED
  OTHER
  SUBMISSION_SUBMITTED
  EVIDENCE_SUBMITTED
  REVIEW_STARTED
  FINDING_RECORDED
  RESUBMITTED
  REVIEW_COMPLETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProjects Project[]
  versions       CreativeVersion[]
  comments       Comment[]
  approvals      Approval[]
  activities     Activity[]

  createdCreatives  Creative[]        @relation("CreativeCreatedBy")
  openedCycles      ReviewCycle[]     @relation("CycleOpenedBy")
  submittedRounds   SubmissionRound[] @relation("RoundSubmittedBy")
  reviewDecisions   ReviewDecision[]  @relation("DecisionReviewer")
  createdFindings   Finding[]         @relation("FindingCreatedBy")
  resolvedFindings  Finding[]         @relation("FindingResolvedBy")
  findingEvents     FindingEvent[]
  findingResponses  FindingResponse[]
  findingEvidence   FindingEvidence[]
  addedEvidence     Evidence[]        @relation("EvidenceAddedBy")
  withdrawnEvidence Evidence[]        @relation("EvidenceWithdrawnBy")

  isPolicyAdmin              Boolean             @default(false)
  createdPolicyRuleVersions  PolicyRuleVersion[] @relation("RuleVersionCreatedBy")
  approvedPolicyRuleVersions PolicyRuleVersion[] @relation("RuleVersionApprovedBy")

  clientConversations        Conversation[]               @relation("ConversationClient")
  reviewerConversations      Conversation[]               @relation("ConversationReviewer")
  sentMessages               Message[]                    @relation("MessageSender")
  readMessages               Message[]                    @relation("MessageReader")
  // Lifecycle records (Oct 19 sprint)
  aiScanRuns                 AIScanRun[]                  @relation("ScanInitiatedBy")
  externalSubmissions        ExternalSubmission[]         @relation("ExternalSubmissionRecordedBy")
  externalOutcomes           ExternalOutcome[]            @relation("ExternalOutcomeRecordedBy")
  policyRuleEvents           PolicyRuleEvent[]            @relation("PolicyRuleEventActor")
  // P0 policy verification and evidence assessment (Oct 27)
  verifiedPolicyRuleVersions PolicyRuleVersion[]          @relation("RuleVersionVerifiedBy")
  verifiedPolicySources      PolicySource[]               @relation("SourceVerifiedBy")
  evidenceAssessments        EvidenceAssessment[]         @relation("EvidenceAssessedBy")
  // Policy source monitoring (Oct 31)
  triggeredSourceSnapshots   PolicySourceSnapshot[]       @relation("SnapshotTriggeredBy")
  detectedSourceChanges      PolicySourceChangeProposal[] @relation("ChangeDetectedBy")
  resolvedSourceChanges      PolicySourceChangeProposal[] @relation("ChangeResolvedBy")
}

// A campaign/client project, e.g. "Acme Health — Q4 Campaign".
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  clientId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client     User       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creatives  Creative[]
  activities Activity[]

  @@index([clientId])
}

// A creative. In the SUBMISSION_REVIEW workflow this is a client submission.
model Creative {
  id          String           @id @default(cuid())
  projectId   String
  name        String
  description String?
  // Campaign context for reviewers: objective, audience, key message.
  context     String?
  format      CreativeFormat   @default(FEED)
  status      CreativeStatus   @default(DRAFT)
  workflow    CreativeWorkflow @default(SUBMISSION_REVIEW)
  // Who created the record (client, or team on the client's behalf). Null on legacy rows.
  createdById String?
  // First submission time. Null until submitted, and on legacy rows.
  submittedAt DateTime?
  // Chosen by the client (HEALTHCARE, MEDICAL_AESTHETICS or OTHER); decides
  // which industry-specific policy rules may apply. Null on older rows.
  industry    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("CreativeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions  CreativeVersion[]
  evidence  Evidence[]
  comments  Comment[]
  approvals Approval[]

  cycles              ReviewCycle[]
  rounds              SubmissionRound[]
  decisions           ReviewDecision[]
  findings            Finding[]
  markets             SubmissionMarket[]
  platforms           SubmissionPlatform[]
  activities          Activity[]
  aiScanRuns          AIScanRun[]
  externalSubmissions ExternalSubmission[]

  conversations Conversation[]

  @@index([projectId])
  @@index([createdById])
}

model CreativeVersion {
  id            String     @id @default(cuid())
  creativeId    String
  versionNumber Int
  // Private Vercel Blob URL. Files are served through /api/media/[versionId],
  // never linked directly. File contents are never stored in PostgreSQL.
  fileUrl       String
  // Blob pathname (storage key). Also the idempotency key for retried uploads.
  filePathname  String?
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  mediaType     MediaType?
  changeNotes   String?
  createdById   String
  createdAt     DateTime   @default(now())

  creative  Creative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  comments  Comment[]
  approvals Approval[]

  rounds              SubmissionRound[]
  decisions           ReviewDecision[]
  findings            Finding[]            @relation("FindingIdentifiedIn")
  resolvedFindings    Finding[]            @relation("FindingResolvedIn")
  findingResponses    FindingResponse[]
  evidence            Evidence[]
  aiScanRuns          AIScanRun[]
  externalSubmissions ExternalSubmission[]

  // A creative can never have two versions with the same number.
  @@unique([creativeId, versionNumber])
}

// Supporting research/context for a creative. Legacy rows: origin and addedById
// are null. New rows always record who added them. Never marked "verified".
model Evidence {
  id                  String             @id @default(cuid())
  creativeId          String
  title               String
  type                EvidenceType
  description         String?
  source              String?
  // Optional reference link (http/https only, validated on the server).
  url                 String?
  date                DateTime?
  createdAt           DateTime           @default(now())
  origin              EvidenceOrigin?
  addedById           String?
  visibility          EvidenceVisibility @default(SHARED)
  // Optional: the version this evidence refers to.
  versionId           String?
  // Evidence in a submitted cycle is withdrawn, never deleted.
  withdrawnAt         DateTime?
  withdrawnById       String?
  // Optional uploaded file (private Blob; served only via /api/evidence/[id]).
  fileUrl             String?
  fileName            String?
  mimeType            String?
  fileSize            Int?
  // P0 (Oct 27): the claim in the creative this evidence supports, and where
  // it appears. Free text (no separate claims entity, decision D3).
  claimText           String?
  claimLocation       String?
  // Clyntique (REVIEWER_ADDED) evidence only: the reviewed rule version it cites.
  policyRuleVersionId String?

  creative          Creative             @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  addedBy           User?                @relation("EvidenceAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  withdrawnBy       User?                @relation("EvidenceWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  version           CreativeVersion?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  findings          FindingEvidence[]
  externalOutcomes  ExternalOutcome[]
  policyRuleVersion PolicyRuleVersion?   @relation("EvidencePolicyRuleVersion", fields: [policyRuleVersionId], references: [id], onDelete: Restrict)
  assessments       EvidenceAssessment[]

  @@index([creativeId])
  @@index([policyRuleVersionId])
}

model Comment {
  id         String   @id @default(cuid())
  creativeId String
  versionId  String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creative Creative        @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version  CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([creativeId])
  @@index([versionId])
}

// Legacy client decisions (pre-compliance workflow). Unchanged; read-only history.
model Approval {
  id         String         @id @default(cuid())
  creativeId String
  versionId  String
  userId     String
  status     ApprovalStatus
  // Required explanation when status is CHANGES_REQUESTED.
  reason     String?
  createdAt  DateTime       @default(now())

  creative Creative        @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version  CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([creativeId])
  @@index([versionId])
}

// ---------------------------------------------------------------------------
// Submission review workflow

// One review cycle: from submission to a FINAL decision. A later reopening
// (not implemented; plan D7) would start cycle n+1 and leave cycle n intact.
model ReviewCycle {
  id           String    @id @default(cuid())
  creativeId   String
  number       Int
  openedById   String
  openedReason String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  creative             Creative             @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  openedBy             User                 @relation("CycleOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  rounds               SubmissionRound[]
  decisions            ReviewDecision[]
  findings             Finding[]
  // Re-review (Oct 19 sprint): why a cycle after the first was opened, and
  // the policy version that triggered it, if any. Cycle 1 has neither.
  reasonKind           ReviewCycleReason?
  triggerRuleVersionId String?
  triggerRuleVersion   PolicyRuleVersion?   @relation("CycleTriggerRuleVersion", fields: [triggerRuleVersionId], references: [id], onDelete: Restrict)
  aiScanRuns           AIScanRun[]
  externalSubmissions  ExternalSubmission[]
  evidenceAssessments  EvidenceAssessment[]

  @@unique([creativeId, number])
}

// One submit or resubmit within a cycle, fixing the exact version submitted.
model SubmissionRound {
  id                   String   @id @default(cuid())
  creativeId           String
  cycleId              String
  number               Int
  versionId            String
  submittedById        String
  submittedAt          DateTime @default(now())
  note                 String?
  // What the client submitted with this round (title, description, campaign
  // context). The team reads these, so a client's later edits stay private
  // until they resubmit. Null only if written before this snapshot existed.
  submittedName        String?
  submittedDescription String?
  submittedContext     String?
  // The industry the client declared with this round (P0, Oct 27).
  submittedIndustry    String?

  creative    Creative          @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  cycle       ReviewCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  version     CreativeVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  submittedBy User              @relation("RoundSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  decisions   ReviewDecision[]
  responses   FindingResponse[]
  aiScanRuns  AIScanRun[]

  @@unique([cycleId, number])
  @@index([creativeId])
}

// A human reviewer's decision on one round's version. Immutable.
model ReviewDecision {
  id         String             @id @default(cuid())
  creativeId String
  cycleId    String
  roundId    String
  versionId  String
  reviewerId String
  kind       ReviewDecisionKind
  // Required for FINAL decisions, null for CHANGES_REQUESTED (enforced in code).
  outcome    ReviewOutcome?
  summary    String
  // What the review covered, e.g. markets/platforms considered. Free text.
  scopeNote  String?
  createdAt  DateTime           @default(now())

  creative Creative        @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  cycle    ReviewCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  round    SubmissionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  version  CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer User            @relation("DecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  // At most one decision per round.
  @@unique([roundId])
  @@index([creativeId])
  @@index([versionId])
}

// A human reviewer's finding. Issue text is fixed once published; history
// lives in FindingEvent and FindingResponse. Future claim/rule links are
// additive nullable columns (not modelled yet).
model Finding {
  id                  String          @id @default(cuid())
  creativeId          String
  cycleId             String
  // Version where the issue was identified.
  versionId           String?
  createdById         String
  issue               String
  explanation         String
  severity            FindingSeverity
  requiredAction      FindingAction
  actionDetails       String
  status              FindingStatus   @default(DRAFT)
  publishedAt         DateTime?
  resolvedById        String?
  resolvedAt          DateTime?
  resolutionNote      String?
  resolvedInVersionId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  creative          Creative          @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  cycle             ReviewCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  version           CreativeVersion?  @relation("FindingIdentifiedIn", fields: [versionId], references: [id], onDelete: SetNull)
  resolvedInVersion CreativeVersion?  @relation("FindingResolvedIn", fields: [resolvedInVersionId], references: [id], onDelete: SetNull)
  createdBy         User              @relation("FindingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy        User?             @relation("FindingResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  events            FindingEvent[]
  responses         FindingResponse[]
  evidence          FindingEvidence[]
  markets           FindingMarket[]
  platforms         FindingPlatform[]

  // Optional link to the cited compliance policy rule version.
  // Historical references are permanently preserved: onDelete Restrict.
  ruleVersionId String?
  ruleVersion   PolicyRuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  // P0 (Oct 27): the claim and part of the creative concerned, an optional
  // example of compliant wording, and where the finding came from.
  claimText         String?
  claimLocation     String?
  suggestedRevision String?
  origin            FindingOrigin @default(REVIEWER)
  aiScanRunId       String?
  aiScanRun         AIScanRun?    @relation(fields: [aiScanRunId], references: [id], onDelete: SetNull)

  @@index([creativeId])
  @@index([cycleId])
  @@index([ruleVersionId])
}

// Where a finding came from. Either way a human reviewer recorded it; an AI
// suggestion is never a finding until a reviewer accepts it.
enum FindingOrigin {
  REVIEWER
  AI_SUGGESTION_ACCEPTED
}

// Append-only status history of a finding.
model FindingEvent {
  id         String         @id @default(cuid())
  findingId  String
  fromStatus FindingStatus?
  toStatus   FindingStatus
  actorId    String
  note       String?
  createdAt  DateTime       @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([findingId])
}

// Append-only remediation thread on a finding (client or reviewer).
model FindingResponse {
  id        String   @id @default(cuid())
  findingId String
  authorId  String
  message   String
  // The revision this response refers to, if any.
  versionId String?
  roundId   String?
  createdAt DateTime @default(now())

  finding Finding          @relation(fields: [findingId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  version CreativeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  round   SubmissionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([findingId])
}

model FindingEvidence {
  findingId  String
  evidenceId String
  linkedById String
  linkedAt   DateTime @default(now())

  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  linkedBy User     @relation(fields: [linkedById], references: [id], onDelete: Restrict)

  @@id([findingId, evidenceId])
  @@index([evidenceId])
}

// ---------------------------------------------------------------------------
// Review context: where the client plans to run the ad. Selecting a market or
// platform does NOT mean its rules are checked, and implies no approval.

model Market {
  code       String     @id // ISO 3166-1 alpha-2 (US, CA, AE) or ISO 3166-2 (e.g. CA-ON)
  name       String
  kind       MarketKind @default(COUNTRY)
  parentCode String?
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)

  parent              Market?              @relation("MarketParent", fields: [parentCode], references: [code], onDelete: Restrict)
  children            Market[]             @relation("MarketParent")
  submissions         SubmissionMarket[]
  findings            FindingMarket[]
  externalSubmissions ExternalSubmission[]
}

model AdPlatform {
  code      String  @id
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  submissions         SubmissionPlatform[]
  findings            FindingPlatform[]
  externalSubmissions ExternalSubmission[]
}

model SubmissionMarket {
  creativeId String
  marketCode String

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  market   Market   @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@id([creativeId, marketCode])
  @@index([marketCode])
}

model SubmissionPlatform {
  creativeId   String
  platformCode String

  creative Creative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  platform AdPlatform @relation(fields: [platformCode], references: [code], onDelete: Restrict)

  @@id([creativeId, platformCode])
  @@index([platformCode])
}

// Optional: markets/platforms a finding is specifically relevant to.
model FindingMarket {
  findingId  String
  marketCode String

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@id([findingId, marketCode])
}

model FindingPlatform {
  findingId    String
  platformCode String

  finding  Finding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  platform AdPlatform @relation(fields: [platformCode], references: [code], onDelete: Restrict)

  @@id([findingId, platformCode])
}

// ---------------------------------------------------------------------------

// Project timeline entries. userId is null for system events.
model Activity {
  id         String       @id @default(cuid())
  projectId  String
  userId     String?
  type       ActivityType
  message    String
  // The submission this event belongs to (new events only; null on older rows).
  creativeId String?
  createdAt  DateTime     @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([creativeId, createdAt])
}

// Failed/successful sign-in attempts, for rate limiting. `key` is a hash of
// the normalised email and client address, never the raw values.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// Compliance Policy Library (M6)
// Managed internally by Clyntique TEAM Policy Administrators.

enum PolicyAuthorityType {
  REGULATION // Government law (FTC, FDA, MOHAP, UAE Media Council)
  PLATFORM_POLICY // Ad platform policies (TikTok, Meta, Google Ads)
  INTERNAL_RISK // Clyntique internal risk guidance & enterprise protocol
}

enum PolicyVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  REQUIRES_REVIEW // the source is unclear or a field could not be confirmed
}

// What kind of limit a rule describes (P0, Oct 27).
enum PolicyRestrictionLevel {
  PROHIBITED
  RESTRICTED
  CONDITIONAL
  DISCLOSURE_REQUIRED
}

// What kind of official publication a source is (P0, Oct 27).
enum PolicySourceKind {
  PLATFORM_POLICY_PAGE
  PLATFORM_HELP_ARTICLE
  STATUTE_OR_REGULATION
  REGULATOR_GUIDANCE
  OTHER_OFFICIAL
}

enum PolicyRuleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  DEPRECATED
}

enum PolicyCategory {
  EFFICACY_CLAIM
  BEFORE_AFTER
  DISCLOSURE
  PRICING_PROMO
  SUBSTANTIATION
  RESTRICTED_PROCEDURES
  MANDATORY_LABELING
  // P0 (Oct 27, decision D7)
  TARGETING_RESTRICTION
  PRESCRIPTION_MEDICINE
  CREDENTIALS_LICENSING
  TESTIMONIAL_ENDORSEMENT
  PERSONAL_HEALTH_ATTRIBUTES
}

// Official regulatory or platform publication source
model PolicySource {
  id                 String                   @id @default(cuid())
  name               String
  authorityName      String
  authorityType      PolicyAuthorityType
  jurisdictionCode   String // "US", "AE", "GLOBAL", etc.
  officialUrl        String
  publishedAt        DateTime?
  // Legacy: defaults to the creation time, so it does not mean "audited".
  // verifiedAt below is the human verification.
  lastAuditedAt      DateTime                 @default(now())
  verificationStatus PolicyVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  // P0 (Oct 27): provenance and human verification.
  sourceKind         PolicySourceKind?
  // How the source was accessed, and any terms or attribution note.
  accessNote         String?
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNote   String?

  // Policy source monitoring (Oct 31). Monitoring never changes the source's
  // verification status or any rule: a detected change only opens a
  // PolicySourceChangeProposal for a policy admin to review.
  monitoringEnabled   Boolean                   @default(false)
  // How often a due check may run (daily by default). No job is scheduled by
  // the application; checks run on demand or from an operator-triggered runner.
  checkIntervalHours  Int                       @default(24)
  lastCheckedAt       DateTime?
  lastCheckOutcome    PolicySourceFetchOutcome?
  consecutiveFailures Int                       @default(0)
  // A human marked the publication as discontinued; checks stop, history stays.
  discontinuedAt      DateTime?
  discontinuedNote    String?

  citations       PolicyRuleVersionSource[]
  verifiedBy      User?                        @relation("SourceVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  events          PolicyRuleEvent[]
  snapshots       PolicySourceSnapshot[]
  changeProposals PolicySourceChangeProposal[]

  @@index([authorityType, jurisdictionCode])
}

// Canonical compliance rule entity
model PolicyRule {
  id                   String              @id @default(cuid())
  code                 String              @unique // e.g. "US-FTC-DISC-01", "AE-MOH-LIC-01", "TIKTOK-HLT-01"
  title                String
  authorityType        PolicyAuthorityType
  jurisdictionCode     String // "US", "AE", "GLOBAL"
  subJurisdiction      String? // e.g. "California", "Dubai"
  platformCode         String? // "TIKTOK", "META", "GOOGLE", null for platform-agnostic
  industry             String              @default("HEALTHCARE") // "HEALTHCARE", "AESTHETICS", "GENERAL"
  category             PolicyCategory
  currentVersionNumber Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  versions PolicyRuleVersion[]
  events   PolicyRuleEvent[]

  @@index([jurisdictionCode, platformCode])
  @@index([authorityType, category])
}

// Immutable rule version with complete audit history and maker-checker tracking
model PolicyRuleVersion {
  id                      String                   @id @default(cuid())
  ruleId                  String
  versionNumber           Int
  title                   String
  summary                 String
  legalExplanation        String
  remediationAction       String
  applicabilityConditions String[]
  exceptions              String[]
  effectiveFrom           DateTime                 @default(now())
  effectiveTo             DateTime?
  status                  PolicyRuleStatus         @default(PENDING_APPROVAL)
  verificationStatus      PolicyVerificationStatus @default(UNVERIFIED)
  changeSummary           String
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  // P0 (Oct 27): structured compliance content, in Clyntique's own words.
  restrictionLevel           PolicyRestrictionLevel?
  restrictedClaims           String[]                @default([])
  substantiationRequirements String[]                @default([])
  // The date the source says the policy took effect. Null = not stated.
  // effectiveFrom/effectiveTo above are Clyntique's own "in use" window.
  officialEffectiveDate      DateTime?
  // Human verification against the cited sources (one person), separate from
  // approval (a different person, decision D1).
  verifiedById               String?
  verifiedAt                 DateTime?
  verificationNote           String?
  // Why the version was marked REQUIRES_REVIEW.
  reviewNote                 String?

  rule            PolicyRule                   @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  createdBy       User                         @relation("RuleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?                        @relation("RuleVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  verifiedBy      User?                        @relation("RuleVersionVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  sources         PolicyRuleVersionSource[]
  findings        Finding[]
  scanChecks      AIScanRuleCheck[]
  triggeredCycles ReviewCycle[]                @relation("CycleTriggerRuleVersion")
  events          PolicyRuleEvent[]
  evidence        Evidence[]                   @relation("EvidencePolicyRuleVersion")
  changeProposals PolicySourceChangeProposal[] @relation("ProposalResultingVersion")

  @@unique([ruleId, versionNumber])
  @@index([status, verificationStatus])
}

// Granular citation connecting rule versions to exact source sections
model PolicyRuleVersionSource {
  id               String    @id @default(cuid())
  versionId        String
  sourceId         String
  sectionReference String // e.g. "16 CFR § 255.5", "Cabinet Resolution 23/2020 Art. 4"
  sectionTitle     String
  directUrl        String
  // A short quotation only (the server caps it); summaries are our own words.
  excerpt          String?
  createdAt        DateTime  @default(now())
  // P0 (Oct 27): the "last updated" date the source page shows, only if it
  // shows one, and when Clyntique read it for this version.
  sourceUpdatedAt  DateTime?
  retrievedAt      DateTime?

  version PolicyRuleVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  source  PolicySource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// Policy source monitoring (Oct 31). Official pages are fetched (on demand, or
// by an operator-triggered runner), normalized and hashed. Each fetch is an
// append-only snapshot. A meaningful difference from the previous good
// snapshot opens a change proposal in the human-review queue. Nothing here
// edits, verifies, approves or retires a rule or a source; those stay with
// the two-person Policy Library workflow.

enum PolicySourceFetchOutcome {
  OK
  REDIRECTED // the final URL differs from the registered official URL
  NOT_FOUND // 404 or 410
  BLOCKED // 403, 429 or a bot challenge
  UNREACHABLE // DNS, connection or timeout failure
  ERROR // any other HTTP or parsing error
  SKIPPED // not fetched: non-official domain, discontinued, or disabled
}

enum PolicyChangeKind {
  CONTENT_CHANGED
  REDIRECTED
  NOT_FOUND
  ACCESS_PROBLEM // repeated blocked or unreachable results
}

enum PolicyChangeProposalStatus {
  PENDING_REVIEW
  NO_RULE_CHANGE // a policy admin read the change and no rule needs updating
  RULE_UPDATE_STARTED // a policy admin opened a new rule version (normal workflow)
  DISMISSED // false positive, e.g. a layout-only change
}

model PolicySourceSnapshot {
  id             String                   @id @default(cuid())
  sourceId       String
  fetchedAt      DateTime                 @default(now())
  requestedUrl   String
  finalUrl       String?
  outcome        PolicySourceFetchOutcome
  httpStatus     Int?
  contentType    String?
  byteLength     Int?
  contentHash    String? // SHA-256 of the normalized text (or of the bytes for binary documents)
  normalizedText String? // capped; the diff shown to reviewers is built from it
  statedDate     DateTime? // a "last updated" or "effective" date the page itself states
  errorMessage   String?
  triggeredById  String? // null for an operator-triggered runner

  source      PolicySource                 @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  triggeredBy User?                        @relation("SnapshotTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  asPrevious  PolicySourceChangeProposal[] @relation("ProposalPreviousSnapshot")
  asNew       PolicySourceChangeProposal[] @relation("ProposalNewSnapshot")

  @@index([sourceId, fetchedAt])
}

model PolicySourceChangeProposal {
  id                 String                     @id @default(cuid())
  sourceId           String
  kind               PolicyChangeKind
  status             PolicyChangeProposalStatus @default(PENDING_REVIEW)
  previousSnapshotId String?
  newSnapshotId      String
  // Machine-written summary of the difference, labelled as such in the UI.
  summary            String
  // Section-level diff: [{ op: "added" | "removed", text }]
  diff               Json?
  // Rule codes whose versions cite this source, computed at detection time.
  affectedRuleCodes  String[]                   @default([])
  detectedById       String
  createdAt          DateTime                   @default(now())
  resolvedById       String?
  resolvedAt         DateTime?
  resolutionNote     String?
  // The rule version a policy admin proposed in response, if any.
  resultingVersionId String?

  source           PolicySource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  previousSnapshot PolicySourceSnapshot? @relation("ProposalPreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Restrict)
  newSnapshot      PolicySourceSnapshot  @relation("ProposalNewSnapshot", fields: [newSnapshotId], references: [id], onDelete: Restrict)
  detectedBy       User                  @relation("ChangeDetectedBy", fields: [detectedById], references: [id], onDelete: Restrict)
  resolvedBy       User?                 @relation("ChangeResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resultingVersion PolicyRuleVersion?    @relation("ProposalResultingVersion", fields: [resultingVersionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([sourceId, createdAt])
}

// ---------------------------------------------------------------------------
// Reviewer chat. A client's conversation with the Clyntique human reviewers,
// about one submitted submission or in general. It is NOT part of the formal
// review: chat never changes a status, finding, decision or evidence, and is
// not written to the project Activity timeline.

model Conversation {
  id                 String   @id @default(cuid())
  clientId           String
  // Null = the client's general conversation (also used for drafts and
  // earlier-workflow creatives, which TEAM must not learn about).
  creativeId         String?
  // "general" or the creative id: one conversation per client and subject.
  subjectKey         String
  // Future routing: the reviewer handling this client or submission. Null = the
  // shared Team inbox (every TEAM user), which is all the MVP uses.
  assignedReviewerId String?
  lastMessageAt      DateTime @default(now())
  createdAt          DateTime @default(now())

  client           User      @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Restrict)
  creative         Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  assignedReviewer User?     @relation("ConversationReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@unique([clientId, subjectKey])
  @@index([assignedReviewerId, lastMessageAt])
  @@index([lastMessageAt])
  @@index([creativeId])
}

// Append-only: messages are never edited or deleted. readAt is set the first
// time the other side opens the conversation.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  // Snapshot of the sender's role, so history stays correct if roles change.
  senderRole     Role
  body           String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  readById       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  readBy       User?        @relation("MessageReader", fields: [readById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([conversationId, senderRole, readAt])
}

// ---------------------------------------------------------------------------
// Lifecycle records (Oct 19 sprint). All additive.

// Why a review cycle after the first was opened (cycle 1 never has one).
enum ReviewCycleReason {
  POLICY_CHANGE // an approved policy rule version changed
  EXTERNAL_OUTCOME // a platform or regulator rejected it or asked for changes
  CLIENT_UPDATE // the client changed the creative or its claims
  EVIDENCE_EXPIRED // supporting evidence is no longer valid
  TEAM_REQUEST // a reviewer asked for another look
}

enum AIScanStatus {
  SUCCESS
  INSUFFICIENT_COVERAGE
  RATE_LIMITED
  ERROR
}

// One AI scan as it was run: which submitted version, which approved rule
// versions were checked, and what the server-validated result was. Append
// only. Raw provider output and secrets are never stored: suggestions are the
// validated ones with citations rebuilt from the Policy Library.
model AIScanRun {
  id                   String       @id @default(cuid())
  creativeId           String
  versionId            String
  cycleId              String?
  roundId              String?
  initiatedById        String
  status               AIScanStatus
  modelUsed            String?
  promptVersion        String?
  summary              String
  // Provider error name only (never the message, which can echo request details).
  errorName            String?
  extractedVisualText  Json         @default("[]")
  detectedClaims       Json         @default("[]")
  suggestedFindings    Json         @default("[]")
  discardedSuggestions Int          @default(0)
  executionTimeMs      Int?
  createdAt            DateTime     @default(now())

  creative     Creative          @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version      CreativeVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  cycle        ReviewCycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  round        SubmissionRound?  @relation(fields: [roundId], references: [id], onDelete: SetNull)
  initiatedBy  User              @relation("ScanInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  rulesChecked AIScanRuleCheck[]
  findings     Finding[]

  @@index([creativeId, createdAt])
  @@index([versionId])
}

// The exact approved rule versions one scan was checked against. Historical
// references are permanently preserved (onDelete Restrict on the version).
model AIScanRuleCheck {
  scanId            String
  ruleVersionId     String
  ruleCode          String // snapshot, for display without a join
  ruleVersionNumber Int

  scan        AIScanRun         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ruleVersion PolicyRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@id([scanId, ruleVersionId])
  @@index([ruleVersionId])
}

enum ExternalDestinationType {
  AD_PLATFORM
  REGULATOR
}

// Where a record came from. CLIENT_REPORTED is what the client told us;
// TEAM_VERIFIED means a TEAM member checked the external document themselves.
// Neither is a Clyntique approval.
enum ExternalRecordBasis {
  CLIENT_REPORTED
  TEAM_VERIFIED
}

enum ExternalOutcomeKind {
  APPROVED // reported as approved by the platform or regulator
  CHANGES_REQUESTED // the platform or regulator asked for changes
  REJECTED
}

// A manual record that a reviewed version was submitted to an ad platform or
// a regulator. Clyntique never submits anything itself: this is bookkeeping.
// Append only; there is no edit or delete.
model ExternalSubmission {
  id                String                  @id @default(cuid())
  creativeId        String
  versionId         String
  cycleId           String?
  destinationType   ExternalDestinationType
  destinationName   String
  platformCode      String?
  marketCode        String?
  submittedOn       DateTime
  externalReference String?
  note              String?
  basis             ExternalRecordBasis
  recordedById      String
  createdAt         DateTime                @default(now())

  creative   Creative          @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version    CreativeVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  cycle      ReviewCycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  platform   AdPlatform?       @relation(fields: [platformCode], references: [code], onDelete: Restrict)
  market     Market?           @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  recordedBy User              @relation("ExternalSubmissionRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  outcomes   ExternalOutcome[]

  @@index([creativeId, createdAt])
  @@index([versionId])
}

// What the platform or regulator answered, as reported or verified. Append
// only: a later outcome supersedes an earlier one but never replaces it.
model ExternalOutcome {
  id           String              @id @default(cuid())
  submissionId String
  kind         ExternalOutcomeKind
  outcomeOn    DateTime
  note         String?
  // Optional supporting document, from the submission's evidence.
  evidenceId   String?
  basis        ExternalRecordBasis
  recordedById String
  createdAt    DateTime            @default(now())

  submission ExternalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evidence   Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  recordedBy User               @relation("ExternalOutcomeRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
}

enum PolicyRuleEventKind {
  RULE_CREATED
  VERSION_PROPOSED
  VERSION_APPROVED
  RULE_RETIRED
  // P0 (Oct 27)
  VERSION_EDITED
  VERSION_VERIFIED
  VERSION_RETURNED
  VERSION_REJECTED
  SOURCE_CREATED
  SOURCE_EDITED
  SOURCE_VERIFIED
  // Policy source monitoring (Oct 31)
  SOURCE_CHANGE_DETECTED
  SOURCE_CHANGE_REVIEWED
  SOURCE_MONITORING_UPDATED
}

// Append-only history of changes to a policy rule or source, written by the
// Policy Library commands. Impact analysis starts from VERSION_APPROVED events.
// Every row names a rule or a source (CHECK constraint in the migration).
model PolicyRuleEvent {
  id        String              @id @default(cuid())
  ruleId    String?
  versionId String?
  sourceId  String?
  kind      PolicyRuleEventKind
  actorId   String
  note      String?
  createdAt DateTime            @default(now())

  rule    PolicyRule?        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  version PolicyRuleVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)
  source  PolicySource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  actor   User               @relation("PolicyRuleEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ruleId, createdAt])
  @@index([sourceId, createdAt])
}

// ---------------------------------------------------------------------------
// Evidence assessment (P0, Oct 27). A TEAM reviewer's internal assessment of
// one client evidence item in one review cycle. Append only: the latest row
// per evidence and cycle is current. Never a scientific or legal validation.
// A client sees it only once a later decision has been published (D5).

enum EvidenceAssessmentResult {
  ACCEPTED_FOR_REVIEW
  INSUFFICIENT
  NOT_RELEVANT
  NEEDS_CLARIFICATION
}

model EvidenceAssessment {
  id         String                   @id @default(cuid())
  evidenceId String
  cycleId    String
  reviewerId String
  result     EvidenceAssessmentResult
  note       String?
  createdAt  DateTime                 @default(now())

  evidence Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewer User        @relation("EvidenceAssessedBy", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([evidenceId, createdAt])
  @@index([cycleId])
}
