// Prisma schema for Clyntique.
// The connection URL is configured in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEAM
  CLIENT
}

enum CreativeStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ARCHIVED
}

// Placement the creative is designed for. Drives the preview aspect ratio.
enum CreativeFormat {
  STORY
  FEED
  STATIC
  VIDEO
}

enum EvidenceType {
  RESEARCH
  STATISTIC
  COMPETITOR
  CUSTOMER_INSIGHT
  SOURCE
  OTHER
}

enum ApprovalStatus {
  APPROVED
  CHANGES_REQUESTED
}

enum ActivityType {
  CREATIVE_UPLOADED
  VERSION_UPLOADED
  FEEDBACK_RECEIVED
  CHANGES_REQUESTED
  CREATIVE_APPROVED
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProjects Project[]
  versions       CreativeVersion[]
  comments       Comment[]
  approvals      Approval[]
  activities     Activity[]
}

// A campaign/client project, e.g. "Acme Health — Q4 Campaign".
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  clientId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client     User       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creatives  Creative[]
  activities Activity[]

  @@index([clientId])
}

model Creative {
  id          String         @id @default(cuid())
  projectId   String
  name        String
  description String?
  format      CreativeFormat @default(FEED)
  status      CreativeStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  CreativeVersion[]
  evidence  Evidence[]
  comments  Comment[]
  approvals Approval[]

  @@index([projectId])
}

model CreativeVersion {
  id            String   @id @default(cuid())
  creativeId    String
  versionNumber Int
  fileUrl       String
  createdById   String
  createdAt     DateTime @default(now())

  creative  Creative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  comments  Comment[]
  approvals Approval[]

  // A creative can never have two versions with the same number.
  @@unique([creativeId, versionNumber])
}

// Supporting research/context shown to the client alongside a creative.
model Evidence {
  id          String       @id @default(cuid())
  creativeId  String
  title       String
  type        EvidenceType
  description String?
  source      String?
  date        DateTime?
  createdAt   DateTime     @default(now())

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
}

model Comment {
  id         String   @id @default(cuid())
  creativeId String
  versionId  String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creative Creative        @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version  CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([creativeId])
  @@index([versionId])
}

model Approval {
  id         String         @id @default(cuid())
  creativeId String
  versionId  String
  userId     String
  status     ApprovalStatus
  createdAt  DateTime       @default(now())

  creative Creative        @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  version  CreativeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([creativeId])
  @@index([versionId])
}

// Project timeline entries. userId is null for system events.
model Activity {
  id        String       @id @default(cuid())
  projectId String
  userId    String?
  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}
