# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma (for Render, use the External Database URL).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Secret used to sign session cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# Vercel Blob (creative image/video files). Use a PRIVATE Blob store.
# Connecting the store to the Vercel project adds these automatically; for local
# development run `vercel env pull` (or copy the token from the store page).
# BLOB_READ_WRITE_TOKEN is required to issue browser (client) upload tokens.
BLOB_READ_WRITE_TOKEN=""
# Login rate limiting. Enable ONLY after the M1A migration (LoginAttempt table)
# is applied to this database. RATE_LIMIT_SECRET is optional (falls back to
# SESSION_SECRET); at least 32 characters.
# LOGIN_RATE_LIMIT="enabled"
# RATE_LIMIT_SECRET=""

# Development seed only (prisma/seed.ts). Leave empty unless you are seeding.
# Writes also require SEED_CONFIRM_DATABASE = the database name in DATABASE_URL.
# SEED_TEAM_PASSWORD=""
# SEED_CLIENT_PASSWORD=""
# SEED_CLIENT2_PASSWORD=""
# SEED_CONFIRM_DATABASE=""
# Optional upload limits in MB (defaults: 15 for images, 100 for videos).
# CREATIVE_MAX_IMAGE_MB="15"
# CREATIVE_MAX_VIDEO_MB="100"

# Google Gemini key for TEAM-only AI scans. Without it, scans report
# "AI scan failed — manual review required" (never "no findings").
# GEMINI_API_KEY=""
# Industry of the work this deployment reviews (e.g. HEALTHCARE). Industry-specific
# Policy Library rules apply only when this matches; unset = unknown, and only
# GENERAL rules can apply.
# POLICY_DEFAULT_INDUSTRY=""
# Importing the research candidate policies (unverified drafts) is disabled
# unless explicitly authorized. Imported candidates stay UNVERIFIED either way.
# POLICY_CANDIDATE_IMPORT="enabled"

# Public CLIENT self-registration at /auth/signup (never creates TEAM accounts).
# CLIENT_SIGNUP="enabled"
# Quick demo login (Team / Client 1 / Client 2) on the sign-in page. For an
# isolated demo environment only; always off when VERCEL_ENV=production.
# Unset it to switch the feature off: existing demo sessions end immediately.
# DEMO_LOGIN="enabled"
